# --- Supabase (Project Settings -> API) ---
# Public: safe in the browser. Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy "anon" key both work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI providers (server-only; never prefix with NEXT_PUBLIC_) ---
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Local embeddings need no API key. Optional writable model cache directory:
# TRANSFORMERS_CACHE=.cache/transformers

# --- Optional tuning ---
# Max /api/ai/ask calls per user per hour (cost cap).
AI_ASK_LIMIT_PER_HOUR=30
# Cosine-similarity floor for a chunk to count as evidence (0..1).
RAG_MATCH_THRESHOLD=0.65
RAG_MATCH_COUNT=5

# --- Only for `npm run seed` and `npm run test:integration` ---
# Two throwaway accounts you create in the app first (fictional emails).
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
